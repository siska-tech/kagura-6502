# KAGURA-6502 integrated (BASIC + VDP + 6-channel audio) Gowin build (Commercial 1.9.12.04).
# Derived from fpga/vdp/syn/run_vdp.tcl; adds K65_AUDIO 1 and k65_audio.sv.
# Usage (Git Bash, from fpga/audio/syn):
#   K65_NAME=aud_p1024 K65_NPAT=1024 [K65_PLACE=2] gw_sh run_audio.tcl
set name   $::env(K65_NAME)
set npat   $::env(K65_NPAT)
set R [file normalize ../../..]
file mkdir gen
set f [open gen/cfg_$name.v w]
puts $f "// generated by run_audio.tcl"
puts $f "`define K65_CYC 16"
puts $f "`define K65_FAST 8192"
puts $f "`define K65_ROMB 2048"
puts $f "`define K65_ROMHEX \"../../basic/sw/bios2k_vdp.hex\""
puts $f "`define K65_NPAT $npat"
puts $f "`define K65_PAT_FLAT 0"
puts $f "`define K65_SHARE_PW 1"
puts $f "`define K65_OAM_DBL 0"
puts $f "`define K65_PALHEX \"../../vdp/rtl/vdp_palette.hex\""
puts $f "`define K65_PAL256HEX \"../../vdp/rtl/vdp_palette256.hex\""
puts $f "`define K65_AUDIO 1"
close $f

set_device GW1NR-LV9QN88PC6/I5 -device_version C
add_file -type verilog [file normalize gen/cfg_$name.v]
foreach f [list \
    $R/fpga/vdp/rtl/vdp_top.sv $R/fpga/vdp/rtl/k65_vdp.sv $R/fpga/audio/rtl/k65_audio.sv \
    $R/fpga/basic/rtl/k65_basic_core.v $R/fpga/basic/rtl/k65_uart_rx.v \
    $R/fpga/phase2/rtl/k65_psram_port.sv $R/fpga/phase2/rtl/k65_psram_ctrl.sv \
    $R/fpga/phase1/rtl/k65_uart_tx.v \
    $R/third_party/kagura-9/kagura_hyperram_ctrl.sv $R/third_party/kagura-9/kagura_hyperram_phy_gowin.sv \
    $R/fpga/rtl/hdmi/k65_hdmi_tx.sv $R/fpga/rtl/hdmi/k65_hdmi_phy.v] {
    add_file -type verilog $f
}
add_file $R/fpga/constraints/tn9k_kagura6502.cst
add_file [file normalize audio.sdc]
set_option -verilog_std sysv2017
set_option -top_module vdp_top
set_option -output_base_name $name
set_option -use_sspi_as_gpio 1
set_option -use_mspi_as_gpio 1
set_option -use_cpu_as_gpio 1
# P&R effort: identical to the VDP builds (place_option 2 / route_option 1 / replicate 1)
set place [expr {[info exists ::env(K65_PLACE)] ? $::env(K65_PLACE) : 2}]
set route [expr {[info exists ::env(K65_ROUTE)] ? $::env(K65_ROUTE) : 1}]
set_option -place_option $place
set_option -route_option $route
set_option -replicate_resources 1
run all
